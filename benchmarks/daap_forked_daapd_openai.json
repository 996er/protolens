{
  "protocol": "daap-http",
  "target_name": "forked-daapd-openai",
  "spec_paths": [
    "./specs/daap_http_minimal.txt"
  ],
  "source_root": "/home/ubuntu/experiments/forked-daapd",
  "entrypoints": [
    "src/main.c",
    "src/httpd.c",
    "src/httpd_daap.c"
  ],
  "build_command": "",
  "run_command": "/home/ubuntu/experiments/forked-daapd/src/forked-daapd -d 0 -c /home/ubuntu/experiments/forked-daapd.conf -f",
  "host": "127.0.0.1",
  "port": 3689,
  "run_dir": "/home/ubuntu/experiments/runs/daap-forked-daapd-openai",
  "aflnet": {
    "binary": "/home/ubuntu/protolens/afl-fuzz",
    "timeout_ms": 200000,
    "duration_seconds": 0,
    "dry_run": false,
    "cwd": "/home/ubuntu/experiments",
    "env": {
      "WORKDIR": "/home/ubuntu/experiments"
    },
    "cmd": [
      "/home/ubuntu/protolens/afl-fuzz",
      "-d",
      "-i",
      "/home/ubuntu/experiments/in-daap",
      "-o",
      "/home/ubuntu/experiments/runs/daap-forked-daapd-openai/output",
      "-N",
      "tcp://127.0.0.1/3689",
      "-P",
      "HTTP",
      "-D",
      "200000",
      "-m",
      "none",
      "-q",
      "3",
      "-s",
      "3",
      "-E",
      "-K",
      "-t",
      "5000",
      "--",
      "/home/ubuntu/experiments/forked-daapd/src/forked-daapd",
      "-d",
      "0",
      "-c",
      "/home/ubuntu/experiments/forked-daapd.conf",
      "-f"
    ]
  },
  "source_coverage": {
    "enabled": true,
    "target_cmd": [
      "/home/ubuntu/experiments/forked-daapd-gcov/src/forked-daapd",
      "-d",
      "0",
      "-c",
      "/home/ubuntu/protolens/benchmarks/coverage/forked-daapd.conf",
      "-P",
      "/home/ubuntu/experiments/forked-daapd-coverage.pid",
      "-f"
    ],
    "source_root": "/home/ubuntu/experiments/forked-daapd-gcov",
    "build_root": "/home/ubuntu/experiments/forked-daapd-gcov",
    "cwd": "/home/ubuntu/experiments",
    "host": "127.0.0.1",
    "port": 3690,
    "gcov_binary": "gcov",
    "startup_seconds": 1.0,
    "replay_timeout_seconds": 10.0,
    "shutdown_signal": "SIGUSR1",
    "shutdown_seconds": 3.0,
    "poll_seconds": 1.0,
    "http_host": "0.0.0.0",
    "http_port": 8894,
    "max_monitor_regions": 20,
    "env": {
      "WORKDIR": "/home/ubuntu/experiments"
    }
  },
  "fsm_build": {
    "rfc_queries": [
      "authoritative HTTP/1.1 message syntax, semantics and connection management RFCs for an HTTP-based DAAP server; derive DAAP application behavior from forked-daapd source rather than assuming a DAAP RFC exists"
    ],
    "rfc_analysis_scope": [
      "HTTP request framing, response codes and persistent connections",
      "DAAP server-info, content-codes, login, update and logout sequencing evidenced by forked-daapd",
      "session identifiers, database browsing, item retrieval and DMAP encoding evidenced by source",
      "separate standardized HTTP semantics from implementation-defined DAAP behavior"
    ],
    "target_supported_extensions_only": true,
    "ignore_directories": [
      ".git",
      ".hg",
      ".svn",
      ".idea",
      ".vscode",
      "__pycache__",
      "node_modules",
      "vendor",
      "dist",
      "build",
      "target",
      "coverage",
      "Deprecated"
    ],
    "allowed_rfc_domains": [
      "rfc-editor.org",
      "datatracker.ietf.org",
      "ietf.org"
    ],
    "source_extensions": [
      ".c",
      ".h"
    ],
    "chunk_chars": 80000,
    "max_file_bytes": 2000000,
    "max_web_search_calls": 8
  },
  "llm": {
    "provider": "openai-compatible",
    "model": "workbuddy-ai/deepseek-v4.1-flash",
    "temperature": 0.0,
    "timeout_seconds": 180,
    "response_format": "json_object",
    "max_tokens": 24000,
    "retries": 2
  }
}
