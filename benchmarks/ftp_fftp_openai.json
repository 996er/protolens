{
  "protocol": "ftp",
  "target_name": "fftp-lightftp-openai",
  "spec_paths": [
    "./specs/ftp_minimal.txt"
  ],
  "source_root": "/home/ubuntu/experiments/LightFTP/Source",
  "entrypoints": ["ftpserv.c", "ftpserv.h", "main.c"],
  "build_command": "",
  "run_command": "/home/ubuntu/experiments/LightFTP/Source/Release/fftp /home/ubuntu/experiments/lightftp/fftp.conf 2200",
  "host": "127.0.0.1",
  "port": 2200,
  "transport_harness": {
  "enabled": true,
  "timeout_seconds": 3.0,
  "max_actions": 20
  },
  "run_dir": "/home/ubuntu/experiments/runs/ftp-fftp-openai",
  "aflnet": {
    "binary": "/home/ubuntu/protolens/afl-fuzz",
    "timeout_ms": 1000,
    "duration_seconds": 0,
    "dry_run": false,
    "cwd": null,
    "env": {},
    "cmd": [
      "/home/ubuntu/protolens/afl-fuzz",
      "-d",
      "-i",
      "/home/ubuntu/experiments/in-ftp",
      "-o",
      "/home/ubuntu/experiments/runs/ftp-fftp-openai/output",
      "-x",
      "/home/ubuntu/experiments/ftp.dict",
      "-N",
      "tcp://127.0.0.1/2200",
      "-m",
      "none",
      "-P",
      "FTP",
      "-D",
      "10000",
      "-q",
      "3",
      "-s",
      "3",
      "-E",
      "-K",
      "-R",
      "-c",
      "/home/ubuntu/experiments/ftpclean",
      "--",
      "/home/ubuntu/experiments/LightFTP/Source/Release/fftp",
      "/home/ubuntu/experiments/LightFTP/Source/Release/fftp.conf",
      "2200"
    ]
  },
  "source_coverage": {
  "enabled": true,
  "target_cmd": [
    "/home/ubuntu/experiments/LightFTP-gcov/Source/Release/fftp",
    "/home/ubuntu/experiments/LightFTP-gcov/Source/Release/fftp.conf",
    "2201"
  ],
  "source_root": "/home/ubuntu/experiments/LightFTP-gcov/Source",
  "build_root": "/home/ubuntu/experiments/LightFTP-gcov/Source/Release",
  "cwd": "/home/ubuntu/experiments/LightFTP-gcov/Source/Release",
  "host": "127.0.0.1",
  "port": 2201,
  "gcov_binary": "gcov",
  "startup_seconds": 0.2,
  "replay_timeout_seconds": 3.0,
  "shutdown_signal": "SIGUSR1",
  "shutdown_seconds": 3.0,
  "poll_seconds": 1.0,
  "http_host": "127.0.0.1",
  "http_port": 8881,
  "max_monitor_regions": 20
  },
  "fsm_build": {
    "rfc_queries": [
      "latest authoritative FTP RFCs including security extensions, updates, and obsolete relationships"
    ],
    "rfc_analysis_scope": [
      "control connection lifecycle and states",
      "authentication and command sequencing",
      "data connection establishment",
      "TLS and protocol security extensions",
      "optional extensions evidenced as supported by the target implementation"
    ],
    "target_supported_extensions_only": true,
    "ignore_directories": [
      "Deprecated"
    ],
    "allowed_rfc_domains": [
      "rfc-editor.org",
      "datatracker.ietf.org",
      "ietf.org"
    ],
    "source_extensions": [".c", ".h"],
    "chunk_chars": 80000,
    "max_file_bytes": 2000000,
    "max_web_search_calls": 8
  },
  "llm": {
    "provider": "openai-compatible",
    "model": "workbuddy-ai/deepseek-v4.1-flash",
    "temperature": 0.0,
    "timeout_seconds": 180,
    "response_format": "json_object",
    "max_tokens": 24000,
    "retries": 2
  }
}
