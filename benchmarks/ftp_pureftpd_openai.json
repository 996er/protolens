{
  "protocol": "ftp",
  "target_name": "pureftpd-openai",
  "spec_paths": [
    "./specs/ftp_minimal.txt"
  ],
  "source_root": "/home/ubuntu/experiments/pure-ftpd",
  "entrypoints": [
    "src/ftpd.c"
  ],
  "build_command": "",
  "run_command": "/home/ubuntu/experiments/pure-ftpd/src/pure-ftpd -A",
  "host": "127.0.0.1",
  "port": 21,
  "run_dir": "/home/ubuntu/experiments/runs/ftp-pureftpd-openai",
  "aflnet": {
    "binary": "/home/ubuntu/protolens/afl-fuzz",
    "timeout_ms": 10000,
    "duration_seconds": 0,
    "dry_run": false,
    "cwd": "/home/ubuntu/experiments/pure-ftpd",
    "env": {
      "WORKDIR": "/home/ubuntu/experiments"
    },
    "cmd": [
      "/home/ubuntu/protolens/afl-fuzz",
      "-d",
      "-i",
      "/home/ubuntu/experiments/in-ftp",
      "-o",
      "/home/ubuntu/experiments/runs/ftp-pureftpd-openai/output",
      "-x",
      "/home/ubuntu/experiments/ftp.dict",
      "-N",
      "tcp://127.0.0.1/21",
      "-m",
      "none",
      "-P",
      "FTP",
      "-D",
      "10000",
      "-q",
      "3",
      "-s",
      "3",
      "-E",
      "-K",
      "-t",
      "5000",
      "-c",
      "/home/ubuntu/experiments/clean",
      "--",
      "/home/ubuntu/experiments/pure-ftpd/src/pure-ftpd",
      "-A"
    ]
  },
  "source_coverage": {
    "enabled": false,
    "target_cmd": [
      "/home/ubuntu/experiments/pure-ftpd-gcov/src/pure-ftpd",
      "-A",
      "-S",
      "127.0.0.1,2123"
    ],
    "source_root": "/home/ubuntu/experiments/pure-ftpd-gcov",
    "build_root": "/home/ubuntu/experiments/pure-ftpd-gcov",
    "cwd": "/home/ubuntu/experiments/pure-ftpd-gcov",
    "host": "127.0.0.1",
    "port": 2123,
    "gcov_binary": "gcov",
    "startup_seconds": 0.2,
    "replay_timeout_seconds": 3.0,
    "shutdown_signal": "SIGTERM",
    "shutdown_seconds": 3.0,
    "poll_seconds": 1.0,
    "http_host": "0.0.0.0",
    "http_port": 8885,
    "max_monitor_regions": 20,
    "env": {
      "WORKDIR": "/home/ubuntu/experiments"
    }
  },
  "fsm_build": {
    "rfc_queries": [
      "latest authoritative FTP RFCs including security extensions, updates, and obsolete relationships"
    ],
    "rfc_analysis_scope": [
      "control connection lifecycle and states",
      "authentication and command sequencing",
      "data connection establishment",
      "TLS and protocol security extensions",
      "optional extensions evidenced as supported by the target implementation"
    ],
    "target_supported_extensions_only": true,
    "ignore_directories": [
      ".git",
      ".hg",
      ".svn",
      ".idea",
      ".vscode",
      "__pycache__",
      "node_modules",
      "vendor",
      "dist",
      "build",
      "target",
      "coverage",
      "Deprecated"
    ],
    "allowed_rfc_domains": [
      "rfc-editor.org",
      "datatracker.ietf.org",
      "ietf.org"
    ],
    "source_extensions": [
      ".c",
      ".h"
    ],
    "chunk_chars": 80000,
    "max_file_bytes": 2000000,
    "max_web_search_calls": 8
  },
  "llm": {
    "provider": "openai-compatible",
    "model": "deepseek-flash",
    "temperature": 0.0,
    "timeout_seconds": 180,
    "response_format": "json_object",
    "max_tokens": 24000,
    "retries": 2
  }
}
